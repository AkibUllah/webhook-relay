APP_ENV=development
LOG_LEVEL=INFO

# SQLite for local dev; Postgres in docker-compose
DATABASE_URL=sqlite:///./relay.db
# DATABASE_URL=postgresql+psycopg://relay:relay@db:5432/relay

# Admin API key required on /v1/* when set (leave empty to disable auth in local dev)
API_KEY=change-me

# Delivery worker
WORKER_ENABLED=true
POLL_INTERVAL_SECONDS=2
BATCH_SIZE=50
HTTP_TIMEOUT_SECONDS=10
MAX_ATTEMPTS=7
# Seconds to wait before retry 1..N (last value repeats). 10s, 1m, 5m, 30m, 2h, 12h
BACKOFF_SCHEDULE=10,60,300,1800,7200,43200
JITTER_FRACTION=0.1

# Per-endpoint circuit breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=300
